# Copy this file to .env and fill in the key. .env is git-ignored.
# Leave GOOGLE_MAPS_API_KEY empty to run with sample commute data (no network needed).
#
# Get a key: Google Cloud Console > APIs & Services > Credentials > Create API key.
# Then enable "Routes API" for the project, and restrict the key to the Routes API.
GOOGLE_MAPS_API_KEY=

# Port for the API server. The Vite dev server proxies /api to it.
API_PORT=8787

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute per IP.
RATE_LIMIT_PER_MIN=300
